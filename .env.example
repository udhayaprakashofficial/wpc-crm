AUTH_SECRET="replace-with-a-long-random-secret"

# Required for Prisma: Project Settings → Database → Connection string → URI
# Prefer the Transaction pooler (port 6543) for Vercel/serverless.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Optional override used by the app at runtime (recommended on Vercel)
# DATABASE_POOL_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# WhatsApp number for in-app “Help chat” (with country code, e.g. 9198XXXXXXXX)
NEXT_PUBLIC_HELP_WHATSAPP=9198XXXXXXXX
# Support / help email
NEXT_PUBLIC_HELP_EMAIL=webproductcreator@gmail.com

# Optional — Meta Pixel on /pay/success (Purchase event)
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Razorpay (KEY_SECRET never goes to the browser)
RAZORPAY_KEY_ID=rzp_test_…
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_…
# Subscription plan ids (auto-renew). Create under the SAME account as the keys.
RAZORPAY_PLAN_MONTHLY=plan_
RAZORPAY_PLAN_YEARLY=plan_
# Optional webhook secret for renewals / cancel events
# RAZORPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

AUTH_SECRET="replace-with-a-long-random-secret"

# Required for Prisma: Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# WhatsApp number for in-app “Help chat” (with country code, e.g. 9198XXXXXXXX)
NEXT_PUBLIC_HELP_WHATSAPP=9198XXXXXXXX

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Dodo Payments (Settings → Billing upgrades)
# Create key + products in https://app.dodopayments.com (Developer → API Keys / Products)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=
# Yearly Pro product only (₹1,749/yr). Monthly env kept for legacy webhooks only.
DODO_PRODUCT_PAID_YEARLY=
DODO_PRODUCT_PAID_MONTHLY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

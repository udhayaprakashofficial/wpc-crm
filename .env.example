AUTH_SECRET="replace-with-a-long-random-secret"

# Required for Prisma. On Vercel, prefer Transaction pooler (IPv4) — direct
# db.<ref>.supabase.co is often IPv6-only and sign-in will 500.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Or keep a direct URL locally and set pooler host for serverless:
# DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# SUPABASE_POOLER_HOST=aws-1-ap-southeast-1.pooler.supabase.com
# DATABASE_POOL_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# WhatsApp number for in-app “Help chat” (with country code, e.g. 9198XXXXXXXX)
NEXT_PUBLIC_HELP_WHATSAPP=9198XXXXXXXX
# Support / help email
NEXT_PUBLIC_HELP_EMAIL=webproductcreator@gmail.com

# Optional — Meta Pixel on /pay/success (Purchase event)
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Razorpay (KEY_SECRET never goes to the browser)
# KEY_ID + KEY_SECRET + PLAN_* must all be from the SAME Razorpay account/mode.
# Mismatched keys cause: "The ID provided is invalid or could not be found."
RAZORPAY_KEY_ID=rzp_test_…
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_…   # should equal RAZORPAY_KEY_ID
# Subscription plan ids (auto-renew). Optional — Orders fallback if missing/invalid.
RAZORPAY_PLAN_MONTHLY=plan_
RAZORPAY_PLAN_YEARLY=plan_
# Optional webhook secret for renewals / cancel events
# RAZORPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
